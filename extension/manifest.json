{
  "manifest_version": 3,
  "name": "GMapLists Parser Companion",
  "version": "0.1.11",
  "description": "Extract Google Maps saved lists into the GMapList web app.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "*://www.google.com/*",
    "*://maps.google.com/*",
    "*://maps.app.goo.gl/*",
    "https://gmaplist.hong-yi.me/*",
    "https://*.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GMapLists",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-32x32.png",
      "64": "icons/icon-64x64.png",
      "128": "icons/icon-128x128.png"
    }
  },
  "icons": {
    "32": "icons/icon-32x32.png",
    "64": "icons/icon-64x64.png",
    "128": "icons/icon-128x128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/*",
        "*://maps.google.com/*",
        "*://maps.app.goo.gl/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.google.com/*",
        "*://maps.google.com/*",
        "*://maps.app.goo.gl/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gmaplist.hong-yi.me/*",
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "appBridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
